# Copy to .env (for docker-compose) and/or backend/.env (for local dev).

# Your free Finnhub API key (https://finnhub.io). Required for LIVE market data.
# The replay simulator works without it.
FINNHUB_API_KEY=

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# Force the random-walk simulator instead of the live Finnhub feed.
# 1 = always simulate (great for demos when the US market is closed).
# 0 = live during US market hours, simulate otherwise.
STOCKSENSE_FORCE_REPLAY=1
